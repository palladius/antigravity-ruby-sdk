# =============================================================================
# Antigravity Ruby SDK - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.dist .env
#
# NOTE: .env is gitignored and MUST NOT be committed.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Your Gemini API key. Get one at https://aistudio.google.com/apikey
# Used by the localharness to authenticate with the Gemini API.
GEMINI_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# OPTIONAL - Model
# ---------------------------------------------------------------------------

# Override the default Gemini model. The SDK defaults to gemini-2.5-flash-lite.
# GEMINI_MODEL and ANTIGRAVITY_MODEL are equivalent; GEMINI_MODEL takes priority.
# Available models: gemini-2.5-flash-lite, gemini-3.5-flash, gemini-3.1-pro-preview, etc.
# Run: curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
# GEMINI_MODEL=gemini-2.5-flash-lite
# ANTIGRAVITY_MODEL=gemini-2.5-flash-lite

# ---------------------------------------------------------------------------
# OPTIONAL - Harness Binary
# ---------------------------------------------------------------------------

# Override the localharness binary path. If unset, the SDK searches:
#   1. ~/.antigravity/bin/localharness
#   2. PATH lookup (which localharness)
#   3. Auto-download from PyPI (see ANTIGRAVITY_AUTO_DOWNLOAD)
# ANTIGRAVITY_HARNESS_PATH=/path/to/localharness

# Allow auto-downloading the localharness binary from PyPI when not found.
# Set to "false" to disable (e.g., in CI or air-gapped environments).
# Default: true
# ANTIGRAVITY_AUTO_DOWNLOAD=true

# ---------------------------------------------------------------------------
# OPTIONAL - Logging
# ---------------------------------------------------------------------------

# Enable/disable the automagic agent logger.
# Values: true, false, 0, 1, no, none
# Default: true (logs to log/antigravity.log)
# ANTIGRAVITY_LOGGER=true

# When set, agent logs go to log/<RAILS_ENV>.log instead of log/antigravity.log
# RAILS_ENV=development

# Same as RAILS_ENV but for Rack-based apps (Sinatra, etc.)
# RACK_ENV=development
